# M212 frontend (Cloudflare Pages; values are public and bundled into the browser)
# Use the NEW publishable/anon key after rotating the exposed credentials.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_NEW_SUPABASE_PUBLISHABLE_OR_ANON_KEY
VITE_SITE_URL=https://m212.ma
VITE_API_BASE_URL=https://api.m212.ma

# NEVER add service_role / sb_secret / database passwords / CMI Store Key here.
# VITE_* variables are public. Server-only values belong in Supabase Edge Function
# secrets or a dedicated backend secret store, never in Cloudflare Pages build vars.

# Server-side Supabase Edge Function secrets (set with supabase secrets set):
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_ANON_KEY=YOUR_NEW_SUPABASE_PUBLISHABLE_OR_ANON_KEY
# SUPABASE_SERVICE_ROLE_KEY=YOUR_NEW_SUPABASE_SECRET_KEY
# ADMIN_DASHBOARD_ORIGINS=https://m212.ma,https://www.m212.ma
# PROVIDER_WORKER_SECRET=GENERATE_A_LONG_RANDOM_SECRET
# CMS_SCHEDULER_SECRET=GENERATE_A_LONG_RANDOM_SECRET

# CMI — server-side ONLY; do not set as VITE_* or Cloudflare Pages frontend variables.
# Configure only after CMI issues merchant credentials and confirms the integration profile.
# CMI_ENVIRONMENT=sandbox
# CMI_CLIENT_ID=YOUR_CMI_CLIENT_ID
# CMI_STORE_KEY=YOUR_CMI_STORE_KEY
# CMI_SHOP_URL=https://m212.ma
# CMI_OK_URL=https://m212.ma/checkout/success
# CMI_FAIL_URL=https://m212.ma/checkout/failure
# CMI_CALLBACK_URL=https://api.m212.ma/api/payments/cmi/callback
